# Copy to .env and fill in. .env is gitignored and must never be committed.
# Reference: docs/ARCHITECTURE.md section 6

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

DATABASE_URL=postgres://qs:qs@db:5432/qs
REDIS_URL=redis://redis:6379/0

# Anthropic
ANTHROPIC_API_KEY=
AGENT_BUDGET_DAILY_USD=20

# Object storage (MinIO locally, S3-compatible in production)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=qs-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-east-1

# TCSP registry source.
# WARNING: this URL is unverified. Confirm the real endpoint and column names
# with `manage.py sync_tcsp --dry-run` before Phase 1 model work.
TCSP_CSV_URL=https://www.tcsp.cr.gov.hk/open-data/licensees.csv

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudflare Turnstile (not reCAPTCHA - blocked in mainland China)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
