# Copy to .env and fill in. .env is gitignored and must never be committed.
# Reference: docs/ARCHITECTURE.md section 6
#
# This file describes LOCAL development. Production runs on Render, where
# DATABASE_URL, REDIS_URL, PORT and RENDER_EXTERNAL_HOSTNAME are injected by the
# platform and the rest live in the `qs-shared` env group - see
# docs/DEPLOY_RENDER.md and render.yaml.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

DATABASE_URL=postgres://qs:qs@db:5432/qs
REDIS_URL=redis://redis:6379/0

# Anthropic
ANTHROPIC_API_KEY=
AGENT_BUDGET_DAILY_USD=20
# Kill switches (COMPLIANCE section 8). Off = that agent runs its rule-based
# fallback; the platform keeps working, more cases go to a human.
AGENTS_ENABLED=true
AGENT_ENABLED_REVIEW_MODERATION=true
AGENT_ENABLED_NNC1_EXTRACTION=true
AGENT_ENABLED_RFQ_INTAKE=true
AGENT_ENABLED_QUOTE_ANALYSIS=true

# Object storage (MinIO locally, S3-compatible in production)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=qs-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-east-1

# TCSP registry source.
# Verified 2026-08-13: 7,457 rows, UTF-8, CRLF, six columns (see DATA_MODEL.md).
# Re-check with `manage.py sync_tcsp --dry-run` if the import ever rejects the header.
TCSP_CSV_URL=https://www.tcsp.cr.gov.hk/open-data/licensees.csv

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Outbound mail. SITE_URL is how workers build links: they have no request to
# build from, and a relative link in an email is a dead link.
SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=QS Matching <no-reply@example.com>
# Off only for data work (a backfill that re-decides old rows should not mail
# a thousand people about decisions they were told about months ago).
NOTIFICATIONS_ENABLED=true

# Cloudflare Turnstile (not reCAPTCHA - blocked in mainland China)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Internal console. Mounted on this prefix instead of /admin/ so scanners find
# nothing at the default path. Production REFUSES TO BOOT on "admin" - generate
# a random one, e.g. `python -c "import secrets;print(secrets.token_urlsafe(12))"`.
ADMIN_URL=admin
ADMIN_ENABLED=true
# Optional allowlist of client IPs; empty means "any address may reach it".
ADMIN_IP_ALLOWLIST=
# Read X-Forwarded-For for the allowlist. Only ever true behind a proxy we own
# (prod defaults to true on Render); otherwise the header is client-forgeable.
ADMIN_TRUST_PROXY_IP=false

# Uploaded claim evidence: a private bucket, never the public media bucket.
S3_PRIVATE_BUCKET=qs-dev-private
# Lifetime of a signed evidence URL, in seconds.
PRIVATE_FILE_URL_TTL=300
# Virus scanner for uploads. The default marks files scan_pending, which keeps
# them unreadable and blocks claim approval until a real scanner is wired up.
# docker-compose ships a clamav service; switch to it with
# FILE_SCANNER_BACKEND=apps.core.scanning.ClamAvScanner
FILE_SCANNER_BACKEND=apps.core.scanning.UnavailableScanner
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Matching. RFQ_FREE_QUOTES_PER_DAY is the free tier's price list expressed as a
# number: a company may answer this many requests a day before it has to buy
# quotes. RFQ_OPEN_DAYS is how long a request stays answerable - companies spend
# that quota to answer, so a request nobody is waiting on has to stop costing.
RFQ_FREE_QUOTES_PER_DAY=3
RFQ_OPEN_DAYS=14
